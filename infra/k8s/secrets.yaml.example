apiVersion: v1
kind: Secret
metadata:
  name: fieldledger-secrets
  namespace: fieldledger
  labels:
    app.kubernetes.io/name: fieldledger-secrets
    app.kubernetes.io/part-of: fieldledger
type: Opaque
stringData:
  JWT_SECRET: "replace-with-a-secure-random-64-character-secret-key"
  MINIO_ROOT_USER: "fieldledger_minio"
  MINIO_ROOT_PASSWORD: "replace-with-secure-minio-root-password"
  MINIO_ACCESS_KEY: "fieldledger_minio"
  MINIO_SECRET_KEY: "replace-with-secure-minio-root-password"
  INTERNAL_GATEWAY_TOKEN: "replace-with-a-secure-random-32-character-token-for-internal-gateway"
  POSTGRES_PASSWORD: "fieldledger_pass"
